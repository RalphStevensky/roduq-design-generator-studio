# Roduq Design Studio — environment configuration template
# Copy do `.env.local` (gitignored) i wypełnij wartościami z provider dashboards.

# === LLM provider selection (multi-provider — Roduq nie ma vendor lock-in, rule 007) ===
# Wybierz aktywnego providera; @roduq/llm createRouterFromEnv rejestruje tego z kluczem.
LLM_PROVIDER=gemini                # anthropic | openai | gemini | mock

# Anthropic — Claude Sonnet 4.6+ / Opus 4.8
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI — GPT-5 / GPT-4o
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5

# Google Gemini — https://aistudio.google.com/app/apikey  (GEMINI_API_KEY lub GOOGLE_API_KEY)
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3-flash-preview

# NOTE: skopiuj do `.env.local` (gitignored) i wpisz realne wartości. NIE używaj `.env` (NIE jest ignorowany).

# === Roduq output protocol ===
# Output directory dla artifacts consumed by @roduq/cli w roduq-web-starter.
# Default: ${HOME}/.roduq/output. Override gdy chcesz inny location.
# Windows native: C:/Users/<user>/.roduq/output (per BRIDGE.md § 3).
ROduQ_OUTPUT_DIR=

# === Upstream Open Design optional config ===
# Patrz upstream README.md / QUICKSTART.md dla pełnej listy upstream env vars.
# OD_PORT — daemon web proxy target port (set automatically by tools-dev)
# OD_WEB_PORT — web listener port (set automatically by tools-dev)
# Telemetry (POSTHOG_*) — opt-in only, w Roduq deployment outdomyślnie disabled.
